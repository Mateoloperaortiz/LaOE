{
  "name": "casa-digital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "check": "npm run lint && npm run typecheck && npm run deps:check && npm run deadcode && npm run test && npm run test:extractor && npm run test:integration && npm run build",
    "lint": "biome check && bash -n scripts/backup.sh tests/backup/run.sh",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "deps:check": "depcruise src scripts tests --config .dependency-cruiser.cjs && depcruise src --config .dependency-cruiser.runtime.cjs",
    "deadcode": "knip",
    "audit:metrics": "node --import tsx scripts/audit-metrics.ts",
    "test": "node scripts/ci/run.mjs vitest unit",
    "test:watch": "vitest --project unit",
    "test:integration": "node scripts/ci/run.mjs vitest integration",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db-release.ts",
    "db:release": "node --import tsx scripts/db-release.ts",
    "db:reset": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/db-reset.ts",
    "db:seed": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "presence:activate-notice24h": "node --conditions=react-server --import tsx scripts/activate-presence-notice24h.ts",
    "storage:init": "node --env-file-if-exists=.env --import tsx scripts/storage-init.ts",
    "pwa:icons": "node --import tsx scripts/pwa-icons.ts",
    "push:check": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/push-check.ts",
    "bootstrap:admin": "node --conditions=react-server --import tsx scripts/bootstrap-admin.ts",
    "bootstrap:access": "node --conditions=react-server --import tsx scripts/bootstrap-access.ts",
    "smoke": "node scripts/smoke.ts",
    "test:backup": "bash tests/backup/run.sh",
    "ghpoints:import": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/import-ghpoints.ts",
    "copy:sync": "node --import tsx scripts/copy-sync.ts && biome check --write src/shared/copy/textos.generated.ts src/shared/copy/textos.client.generated.ts",
    "prepare": "node scripts/install-hooks.mjs",
    "test:e2e": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/test-e2e.ts",
    "wallet:assets": "node --import tsx scripts/wallet-assets.ts",
    "wallet:check": "node --env-file-if-exists=.env --import tsx scripts/wallet-check.ts",
    "the-games:ensayo": "node --conditions=react-server --import tsx scripts/the-games-ensayo.ts",
    "panal:generate": "node scripts/generate-panal-dictionary.mjs",
    "panal:check": "node scripts/generate-panal-dictionary.mjs --check",
    "wordle:generate": "node scripts/generate-wordle-dictionary.mjs",
    "wordle:check": "node scripts/generate-wordle-dictionary.mjs --check",
    "test:extractor": "uv run --python 3.12 --with-requirements scripts/requirements-normativa.txt python -m unittest discover -s tests/python -v",
    "normativa:import": "node --conditions=react-server --import tsx scripts/normativa-import.ts",
    "fotos:importar": "node --conditions=react-server --import tsx scripts/gallery-import.ts",
    "db:indexes": "node --import tsx scripts/required-indexes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/client-sesv2": "^3.1125.0",
    "@aws-sdk/s3-presigned-post": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tabler/icons-react": "^3.46.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "next": "16.4.1",
    "passkit-generator": "^3.5.8",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "nspell": "2.1.5",
    "pino-pretty": "^13.1.3",
    "railway": "3.11.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "passkit-generator": {
      "joi": "^17.13.8"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "description": "Casa digital de la Organización Estudiantil de la Universidad EAFIT: portal, Mi OE, Participación y GH Points, CRM de comunidad.",
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
