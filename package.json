{
  "name": "casa-digital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "check": "npm run lint && npm run typecheck && npm run deps:check && npm run deadcode && npm run test && npm run test:integration && npm run build",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "deps:check": "depcruise src scripts tests --config .dependency-cruiser.cjs",
    "deadcode": "knip",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db-release.ts",
    "db:release": "node --env-file-if-exists=.env --import tsx scripts/db-release.ts",
    "db:reset": "node --env-file-if-exists=.env --import tsx scripts/db-reset.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "storage:init": "node --env-file-if-exists=.env --import tsx scripts/storage-init.ts",
    "pwa:icons": "node --import tsx scripts/pwa-icons.ts",
    "push:check": "node --env-file-if-exists=.env --import tsx scripts/push-check.ts",
    "migrate:ghpoints": "node --env-file-if-exists=.env --import tsx scripts/migrate-ghpoints.ts",
    "migrate:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-migration.ts",
    "copy:sync": "node --import tsx scripts/copy-sync.ts && biome check --write src/shared/copy/textos.generated.ts",
    "prepare": "lefthook install",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/client-sesv2": "^3.1125.0",
    "@aws-sdk/s3-presigned-post": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "description": "Casa digital de la Organización Estudiantil de la Universidad EAFIT: portal, Mi OE, Participación y GH Points, CRM de comunidad.",
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
