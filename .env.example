# Copiá este archivo a .env para desarrollo local. Los valores coinciden con compose.yaml.
# En Railway estas variables se definen en el servicio; DATABASE_URL y las del bucket van por referencia.

NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Bogota
# El proceso corre en UTC; APP_TIMEZONE es solo presentación (ADR-020).
TZ=UTC
LOG_LEVEL=debug

# Postgres local (OrbStack, puerto 5433 porque 5432 lo usa GHPOINTS)
DATABASE_URL=postgresql://casa:casa@127.0.0.1:5433/casa_digital

# Sesiones y OTP (ADR-010). Generá uno real con: openssl rand -hex 32
SESSION_SECRET=cambiame-por-32-bytes-aleatorios-en-hex-0000000000000000
INSTITUTIONAL_EMAIL_DOMAINS=eafit.edu.co
# Código fijo solo fuera de producción; el arranque falla si está definido en producción.
OTP_FIXED_CODE=123456

# Correo: console imprime en la terminal; resend exige RESEND_API_KEY.
MAILER=console
EMAIL_FROM="OE EAFIT <noreply@localhost>"
RESEND_API_KEY=
# Desbordamiento a SES desde este número de envíos diarios por Resend; SES usa las credenciales AWS_*.
RESEND_DAILY_LIMIT=95
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bucket de medios (ADR-022). En local: Garage.
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=media
S3_ACCESS_KEY_ID=GK0c1a5ad191ta1de5a2r0110000dev0
S3_SECRET_ACCESS_KEY=9b3f0e6d2c1a4f8e7d6c5b4a3928170f6e5d4c3b2a190807f6e5d4c3b2a19080
# Garage local usa path-style; en Railway (bucket virtual-hosted) debe ser false.
S3_FORCE_PATH_STYLE=true
# Orígenes adicionales permitidos en el CORS del bucket (separados por coma), además de APP_URL.
MEDIA_CORS_ORIGINS=

# Trabajo de fondo: poller del outbox y scheduler en el mismo proceso (ADR-012).
JOBS_ENABLED=true
JOBS_POLL_INTERVAL_MS=3000
JOBS_BATCH_SIZE=50

# Indexación por buscadores (ADR-033): false deja robots.txt cerrado y noindex en todas las páginas.
# Solo producción la enciende, en el cutover.
PUBLIC_INDEXING=false

# Push web (VAPID, ADR-038). Generá el par con: npx web-push generate-vapid-keys
# Sin claves, los push se imprimen en consola y quedan registrados igual; el subject es un mailto: o una URL https.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:oe@eafit.edu.co

# Solo para el ensayo de migración (scripts/migrate-ghpoints.ts): la copia local de GHPOINTS, nunca la base viva.
# GHPOINTS_DATABASE_URL=postgresql://ghpoints:ghpoints@127.0.0.1:5432/ghpoints
